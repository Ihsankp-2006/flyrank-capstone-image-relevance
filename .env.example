# Docker Compose uses the service name "db" for the database host.
# When running commands directly on the host, use POSTGRES_HOST=127.0.0.1
# and the published POSTGRES_PORT instead.
POSTGRES_DB=flyrank
POSTGRES_USER=flyrank
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Leave empty for offline operation; provide a real key only when Gemini use is approved.
GEMINI_API_KEY=

# Host port published by Docker Compose.
API_PORT=8000
